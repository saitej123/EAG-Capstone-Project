LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_VISION_MODEL=gemini-3.7-flash
# Cheap model for trending-topic / content prep & search (not slide authoring)
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# Gemini Live (mock interview + C.H.I.T.T.I. voice)
# Docs: https://ai.google.dev/gemini-api/docs/live-api/get-started-sdk
# Pricing: audio in $3/1M · audio out $12/1M (paid tier) — tracked in admin costs
INTERVIEW_LIVE_MODEL=gemini-3.1-flash-live-preview
# Optional override for C.H.I.T.T.I. only (empty = INTERVIEW_LIVE_MODEL)
CHITTI_LIVE_MODEL=
# Gemini Live spoken voice (female: Aoede, Kore, Leda, Zephyr)
GEMINI_LIVE_VOICE=Aoede
# Optional rate overrides: model=INPUT/OUTPUT (USD per 1M tokens)
# COST_RATES=gemini-3.1-flash-live-preview=3.00/12.0,gemini-live-2.5-flash-native-audio=3.00/12.0
# Embeddings for sqlite-vec question/topic search
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMS=768
# Nano Banana Pro — thumbnail images ONLY (not slides/content)
GEMINI_IMAGE_MODEL=gemini-3-pro-image
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_NUM_CTX=
OLLAMA_MAX_TOKENS=
LLM_MAX_RETRIES=
LLM_RETRY_BASE_DELAY=
LLM_TIMEOUT_SECONDS=
LLM_MAX_PARALLEL=
VLM_PAGES_PER_CALL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
VLM_DPI=
VLM_MAX_PAGES=
TTS_ENGINE=
KOKORO_VOICE=
KOKORO_LANG=
KOKORO_SPEED=
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
SUPERTONIC_LANG=
SUPERTONIC_DEFAULT_STYLE=
# Optional: auto-build voice clone JSON from saved recordings
# VOICE_STYLE_BUILDER_URL=http://127.0.0.1:8090/build
# VOICE_STYLE_BUILDER_CMD=python /path/to/build_style.py {input} {output}
# SUPERTONE_API_KEY=
# Local clone tuning (CPU): preset match + style_ttl search
VOICE_CLONE_OPTIMIZE_ENABLED=
VOICE_CLONE_OPTIMIZE_STEPS=
CAPTURE_DURATION=
CAPTURE_FPS=
ANIMATION_MODE=
MOTION_SECONDS=
SYNC_HIGHLIGHT=
MOTION_FPS=
CAPTURE_WORKERS=
VIDEO_QUALITY=
VIDEO_CRF=
VIDEO_PRESET=medium
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_PRIVACY=
# Public https origin (no trailing slash) so Instagram Graph can fetch /files/… media
PUBLIC_BASE_URL=
GENERATE_THUMBNAIL=
# auto | nano_banana | off  (Nano Banana Pro thumbnails; local models not installed)
THUMBNAIL_BACKEND=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# Experimental slide AI images (UI default off)
SLIDE_AI_IMAGES_DEFAULT=false
# ----------------------------------------------------------------------------
#  Auth — bootstrap admin (required). Synced to the DB on every server start.
#  Sign in with AUTH_ADMIN_EMAIL or AUTH_ADMIN_USERNAME + AUTH_ADMIN_PASSWORD.
#  Edit these values and restart to change the admin login.
# ----------------------------------------------------------------------------
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_SECRET_KEY=change-me-multimodal-studio-secret
# Session cookies clear when the browser/app closes (default).
# Set AUTH_SESSION_PERSISTENT=true to keep users signed in across restarts.
AUTH_SESSION_PERSISTENT=false
AUTH_SESSION_HOURS=720
# Optional overrides: model=INPUT_RATE/OUTPUT_RATE (USD per 1M tokens), comma-separated.
# Built-ins already cover gemini-3.7-flash, gemini-3.5-flash-lite, gemini-3-pro-image, gpt-4o, etc.
# Example: COST_RATES=gemini-3.7-flash=0.75/3.75,gemini-3-pro-image=2.00/12.00
COST_RATES=
VOICE_LIMIT_USER=
VOICE_LIMIT_ADMIN=
AUTO_ENABLED=false
# trending | hf | arxiv | semantic_scholar
AUTO_SOURCE=trending
AUTO_ARXIV_CATEGORIES=cs.LG,cs.CL,cs.CV,cs.AI,cs.NE,stat.ML
# Optional override for GenAI abs/ti keywords (empty = built-in defaults)
AUTO_ARXIV_KEYWORDS=
AUTO_SS_QUERY=large language model OR multimodal OR diffusion OR generative AI
AUTO_SS_API_KEY=
AUTO_REQUIRE_CODE=
AUTO_MAX_PAPERS=
AUTO_MAKE_VIDEO=
AUTO_VIDEO_FORMAT=
AUTO_VIDEO_SECONDS=480
# Leave empty/false — cron renders long-form video only (one History job per paper).
# Pick Instagram Reels manually in Studio if you want a reel from the same PDF.
AUTO_MAKE_REEL=
AUTO_REEL_FORMAT=
AUTO_REEL_SECONDS=
AUTO_VIDEO_THEME=snow
AUTO_VIDEO_STYLE=whiteboard
AUTO_POCKET_VOICE=jane
AUTO_GENERATE_THUMBNAIL=true
AUTO_PUBLISH=
AUTO_OUTPUT_DIR=
# Off-hours slots (default 1,19 — 13 was blocked by working hours)
AUTO_RUN_HOURS=1,19
AUTO_WORK_START_HOUR=
AUTO_WORK_END_HOUR=
AUTO_COMPUTE_GATE=
AUTO_MAX_LOAD=
AUTO_MIN_GPU_FREE_MB=
AUTO_COMPUTE_WAIT_SECONDS=
# --- Add topics: live web research (free DuckDuckGo + Wikipedia by default) ---
TOPIC_RESEARCH_ENABLED=true
TOPIC_RESEARCH_MAX_RESULTS=4
TOPIC_RESEARCH_FETCH_PAGES=2
TOPIC_RESEARCH_TIMEOUT=8
# Optional faster/paid search APIs (raced first when set):
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
